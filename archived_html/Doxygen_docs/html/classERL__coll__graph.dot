digraph "ERL"
{
 // LATEX_PDF_SIZE
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=record];
  Node1 [label="ERL",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Container class for all submodules."];
  Node2 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" enc" ,fontname="Helvetica"];
  Node2 [label="encoder_",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classencoder__.html",tooltip="Encoder submodule."];
  Node3 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" wb" ,fontname="Helvetica"];
  Node3 [label="wordbank_",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classwordbank__.html",tooltip="Word Bank submodule."];
  Node4 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" dec" ,fontname="Helvetica"];
  Node4 [label="decoder_",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classdecoder__.html",tooltip="Decoder submodule."];
  Node5 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" par" ,fontname="Helvetica"];
  Node5 [label="parser_",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classparser__.html",tooltip="Parser submodule."];
  Node6 -> Node1 [dir="back",color="darkorchid3",fontsize="10",style="dashed",label=" pre" ,fontname="Helvetica"];
  Node6 [label="preprocessor_",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classpreprocessor__.html",tooltip="Preprocessor submodule."];
}
